---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../site.config";
import { formatMonthYear, getYear } from "../../utils/date";

const CURRENT_YEAR = siteConfig.writing.currentYear;

const allWriting = (await getCollection("writing")).filter((a) => !a.data.draft);
const currentArticles = allWriting
  .filter((a) => getYear(a.data.date) === CURRENT_YEAR)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const archiveArticles = allWriting
  .filter((a) => getYear(a.data.date) < CURRENT_YEAR)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const archiveYears = [...new Set(archiveArticles.map((a) => getYear(a.data.date)))].sort((a, b) => b - a);
const defaultArchiveYear = archiveYears[0];
---

<BaseLayout title="Writing — Shouryan Nikam">
  <section class="section">
    <h1 class="hero-title reveal" style="--d:0; view-transition-name: writing-heading">Writing</h1>
    <p class="hero-subtitle reveal" style="--d:1; margin-bottom: 28px;">
      Essays and notes on interfaces, engineering, and craft.
    </p>

    <div class="section-header reveal" style="--d:2">
      <h2 class="section-title">{CURRENT_YEAR}</h2>
    </div>

    <div class="list-group reveal" style="--d:3">
      {currentArticles.map((a) => (
        <a href={`/writing/${a.id}`} class="list-row">
          <div class="row-main">
            <span class="row-title">{a.data.title}</span>
            <span class="row-desc">{a.data.excerpt}</span>
          </div>
          <span class="row-meta">{formatMonthYear(a.data.date)}</span>
        </a>
      ))}
    </div>
  </section>

  {archiveYears.length > 0 && (
    <section id="archive-section" class="section reveal" style="--d:4">
      <details id="archive-details" class="archive-details">
        <summary class="archive-header">
          <span class="archive-toggle">
            <span class="archive-toggle-left">
              <span class="archive-chevron">▸</span>
              <span>Archive</span>
            </span>
          </span>

          <div class="year-pills" id="archive-year-pills" hidden>
            {archiveYears.map((y) => (
              <button
                type="button"
                class={`year-pill ${y === defaultArchiveYear ? "active" : ""}`}
                data-archive-year={y}
              >
                {y}
              </button>
            ))}
          </div>
        </summary>

        <div id="archive-list-wrap" class="list-group">
          {archiveArticles.map((a) => {
            const itemYear = getYear(a.data.date);
            return (
              <a
                href={`/writing/${a.id}`}
                class="list-row"
                data-item-year={itemYear}
                hidden={itemYear !== defaultArchiveYear}
              >
                <div class="row-main">
                  <span class="row-title">{a.data.title}</span>
                  <span class="row-desc">{a.data.excerpt}</span>
                </div>
                <span class="row-meta">{formatMonthYear(a.data.date)}</span>
              </a>
            );
          })}
        </div>
      </details>
    </section>
  )}
</BaseLayout>

<script>
  document.addEventListener("astro:page-load", () => {
    const details = document.getElementById("archive-details") as HTMLDetailsElement | null;
    if (!details || details.dataset.bound) return;
    details.dataset.bound = "1";

    const pillsWrap = document.getElementById("archive-year-pills");
    const listWrap = document.getElementById("archive-list-wrap");
    const summary = details.querySelector("summary");

    const supportsInterpolateSize =
      typeof CSS !== "undefined" &&
      typeof CSS.supports === "function" &&
      CSS.supports("interpolate-size", "allow-keywords");

    if (!supportsInterpolateSize && summary && listWrap) {
      let anim: Animation | null = null;
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

      summary.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).closest("[data-archive-year]")) return;
        if (reducedMotion.matches) return;

        e.preventDefault();
        if (anim) {
          anim.cancel();
          anim = null;
        }

        if (!details.open) {
          details.open = true;
          if (pillsWrap) pillsWrap.hidden = false;
          const endHeight = listWrap.scrollHeight;
          listWrap.style.overflow = "hidden";
          anim = listWrap.animate(
            [
              { height: "0px", opacity: 0 },
              { height: `${endHeight}px`, opacity: 1 }
            ],
            { duration: 240, easing: "cubic-bezier(0.22, 1, 0.36, 1)" }
          );
          anim.onfinish = () => {
            listWrap.style.overflow = "";
            anim = null;
            window.dispatchEvent(new Event("resize"));
          };
        } else {
          const startHeight = listWrap.offsetHeight;
          listWrap.style.overflow = "hidden";
          anim = listWrap.animate(
            [
              { height: `${startHeight}px`, opacity: 1 },
              { height: "0px", opacity: 0 }
            ],
            { duration: 200, easing: "cubic-bezier(0.22, 1, 0.36, 1)" }
          );
          anim.onfinish = () => {
            details.open = false;
            if (pillsWrap) pillsWrap.hidden = true;
            listWrap.style.overflow = "";
            anim = null;
            window.dispatchEvent(new Event("resize"));
          };
        }
      });
    }

    details.addEventListener("toggle", () => {
      if (pillsWrap) pillsWrap.hidden = !details.open;
      window.dispatchEvent(new Event("resize"));
    });

    details.querySelectorAll<HTMLButtonElement>("[data-archive-year]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        const selectedYear = btn.getAttribute("data-archive-year");
        details.querySelectorAll("[data-archive-year]").forEach((b) => {
          b.classList.toggle("active", b.getAttribute("data-archive-year") === selectedYear);
        });
        details.querySelectorAll<HTMLElement>("[data-item-year]").forEach((item) => {
          item.hidden = item.getAttribute("data-item-year") !== selectedYear;
        });
        if (listWrap) {
          listWrap.classList.remove("archive-list-enter");
          void listWrap.offsetWidth;
          listWrap.classList.add("archive-list-enter");
        }
        window.dispatchEvent(new Event("resize"));
      });
    });
  });
</script>
